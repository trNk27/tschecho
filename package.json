{
  "name": "ember",
  "version": "0.1.0",
  "private": true,
  "description": "Ember – co-op campfire survival game. Phones are the controllers, the laptop is the screen.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=server/dist/index.js",
    "start": "node server/dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/sim.test.ts tests/rooms.test.ts"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/qrcode": "^1.5.5",
    "@types/three": "~0.170.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.0",
    "qrcode": "^1.5.4",
    "three": "~0.170.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
